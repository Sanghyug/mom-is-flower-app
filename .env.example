# Server only: configure on Vercel, never prefix a secret with VITE_.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Web: leave empty to call the API on the same origin.
# Toss: .env.toss points to the existing Vercel API server.
VITE_API_BASE_URL=

# Server-only wallet credentials. Do not use VITE_ for these values.
FIREBASE_SERVICE_ACCOUNT_JSON=
CREDIT_IP_SALT=
AI_DAILY_LIMIT=200
TOSS_REWARDED_AD_GROUP_ID=
TOSS_SHARE_MODULE_ID=

# Local UI demonstration only; ignored in production builds.
VITE_WALLET_DEMO=false

# Public Toss banner group ID; leave empty until issued. Never use a rewarded ID here.
VITE_TOSS_BANNER_AD_GROUP_ID=

# Enable only after reviewing Firestore rules for the three new server-only collections.
CARD_SHARING_ENABLED=false
PUBLIC_APP_ORIGIN=https://mom-is-flower.vercel.app

# Optional official HTTPS link returned by getTossShareLink(intoss://mom-is-flower).
TOSS_APP_SHARE_URL=
