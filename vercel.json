{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/analyze-flower.ts": {
      "maxDuration": 60
    },
    "api/flower-story.ts": {
      "maxDuration": 30
    },
    "api/wallet.ts": {
      "maxDuration": 30
    },
    "api/share-card.ts": {
      "maxDuration": 30
    },
    "api/shared-card.ts": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/s/:token",
      "destination": "/api/shared-card?token=:token"
    },
    {
      "source": "/toss",
      "destination": "/api/open-toss"
    }
  ]
}
