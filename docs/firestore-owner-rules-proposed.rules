// Proposed replacement for review. Not deployed.
// Existing flower_cards ownership must be validated before publishing.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /flower_cards/{cardId} {
      allow read, delete: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid
        && request.resource.data.id == cardId;
      allow update: if request.auth != null && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid && request.resource.data.id == cardId;
    }
    // Wallet, share snapshots, ownership and limits are accessed only by Admin SDK.
    match /{document=**} { allow read, write: if false; }
  }
}
